#!/usr/bin/env bash
# Displays DNS record information for the subdomains of a domain
# shellcheck disable=SC2086

audit_subdomain () {
local domain=$1
local sub=$2
dig "$sub.$domain" | grep -A1 'ANSWER SECTION:' | tail -1 | \
awk -v s="$sub" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ $# -eq 1 ]; then
for sub in www lb-01 web-01 web-02; do
audit_subdomain "$1" "$sub"
done
else
audit_subdomain "$1" "$2"
fi
